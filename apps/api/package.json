    "@hukukai/validation": "workspace:*",
    "@hukukai/search-engine": "workspace:*",
    "@hukukai/ai-provider": "workspace:*",
    "@hukukai/rule-engine": "workspace:*",
    "@hukukai/deadline-engine": "workspace:*",
    "@hukukai/calculation-engine": "workspace:*",
    "@hukukai/billing": "workspace:*",
    "@aws-sdk/client-s3": "^3.658.1",
    "@aws-sdk/s3-request-presigner": "^3.658.1",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.2.1",
