// Bkz. Doküman Bölüm 13 — Veritabanı Modeli
// Migration dosyaları geriye dönük değiştirilmez (Bölüm 27).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CITIZEN
  LAWYER
  ACCOUNTANT
  ADMIN
}

enum SubscriptionPlan {
  FREE
  INDIVIDUAL
  PRO
  OFFICE
  ENTERPRISE
}

enum DocumentStatus {
  UPLOADED
  OCR_PROCESSING
  AI_PROCESSING
  REVIEW_REQUIRED
  COMPLETED
  FAILED
}

enum FolderType {
  LEGAL
  ENFORCEMENT
  TAX
  SGK
  RENT
  EXECUTION
  TRAFFIC_FINE
  OTHER
}

enum DeadlineStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum CalculationStatus {
  DRAFT
  COMPLETED
  INVALIDATED
}

enum PaymentTransactionType {
  SUBSCRIPTION_UPGRADE
  ONE_TIME_CREDIT_PACK
}

enum PaymentTransactionStatus {
  COMPLETED
  FAILED
}

// Otonom Mevzuat Sistemi (bkz. CLAUDE.md) — kaynak izleme, değişiklik
// tespiti, etki analizi, kural üretimi ve çok katmanlı doğrulama boru
// hattının veri modeli.
enum LegislationSourceCategory {
  RESMI_GAZETE
  GIB
  SGK
  ADALET_BAKANLIGI
  CTE_GENEL_MUDURLUGU
  ANAYASA_MAHKEMESI
  DIGER_KURUM
}

enum LegislationChangeType {
  NEW_PROVISION
  AMENDED_PROVISION
  REPEALED_PROVISION
  RATE_CHANGE
  THRESHOLD_CHANGE
  DEADLINE_CHANGE
  TEMPORARY_ARTICLE
  EFFECTIVE_DATE_CHANGE
  COURT_ANNULMENT
  DEADLINE_EXTENSION
  ADMINISTRATIVE_HOLIDAY
  IMPLEMENTATION_CIRCULAR
}

enum LegislationChangeStatus {
  DETECTED
  ANALYZING
  RULE_PROPOSED
  VERIFIED
  PUBLISHED
  REJECTED
  HOLD_FOR_REVIEW
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

// RuleSet.isPublished/publishedAt kuralın hesaplama motorlarınca
// GERÇEKTE kullanılıp kullanılmadığının tek kapısıdır (bkz.
// RulesService.getRuleValidOn) — status yalnızca bu kapının nasıl
// yönetildiğini açıklayan, servis katmanınca isPublished ile senkron
// tutulan bir durum etiketidir.
enum RuleSetStatus {
  DRAFT
  CHANGE_DETECTED
  TEMPORARILY_RESTRICTED
  VERIFIED
  CANARY
  ACTIVE
  SUPERSEDED
  REJECTED
}

enum RuleSelectorDateType {
  TRANSACTION_DATE
  OFFENSE_DATE
  JUDGMENT_DATE
  FINALIZATION_DATE
  EXECUTION_DATE
  PUBLICATION_DATE
}

enum VerificationLayer {
  SOURCE_INTEGRITY
  SECOND_SOURCE
  MODEL_CONSENSUS
  SCHEMA_VALIDATION
  GOLDEN_TESTS
  REGRESSION
}

enum RemediationStatus {
  PENDING
  RECALCULATED
  NOTIFIED
}

model User {
  id                      String           @id @default(cuid())
  email                   String           @unique
  passwordHash            String
  fullName                String
  phone                   String?
  role                    UserRole
  subscriptionPlan        SubscriptionPlan @default(FREE)
  oneTimeCreditsRemaining Int              @default(0)
  expoPushToken           String?
  emailVerifiedAt         DateTime?
  isActive                Boolean          @default(true)
  acceptedTermsVersion    String?
  acceptedKvkkVersion     String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  deletedAt               DateTime?

  refreshTokens       RefreshToken[]
  folders             CaseFolder[]
  documents           Document[]
  calculations        Calculation[]
  deadlines           Deadline[]
  generatedDocuments  GeneratedDocument[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  favorites           UserFavoriteTool[]
  usageCounters       UsageCounter[]
  paymentTransactions PaymentTransaction[]

  @@map("users")
}

model UsageCounter {
  id                    String   @id @default(cuid())
  userId                String
  periodKey             String
  documentAnalysisCount Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodKey])
  @@map("usage_counters")
}

model PaymentTransaction {
  id                String                   @id @default(cuid())
  userId            String
  type              PaymentTransactionType
  plan              SubscriptionPlan?
  creditsAdded      Int?
  amount            Decimal                  @db.Decimal(12, 2)
  currency          String                   @default("TRY")
  status            PaymentTransactionStatus
  provider          String
  providerReference String
  createdAt         DateTime                 @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payment_transactions")
}

model ToolDefinition {
  id                   String   @id
  slug                 String   @unique
  name                 String
  shortDescription     String
  categories           Json
  audiences            Json
  keywords             Json
  synonyms             Json
  icon                 String
  route                String
  isActive             Boolean  @default(true)
  isBeta               Boolean  @default(false)
  requiresSubscription Boolean  @default(false)
  rolePriorities       Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  favorites UserFavoriteTool[]

  @@map("tool_definitions")
}

model UserFavoriteTool {
  userId    String
  toolId    String
  createdAt DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool ToolDefinition @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([userId, toolId])
  @@map("user_favorite_tools")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model CaseFolder {
  id              String     @id @default(cuid())
  userId          String
  title           String
  folderType      FolderType
  clientName      String?
  referenceNumber String?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents          Document[]
  calculations       Calculation[]
  deadlines          Deadline[]
  generatedDocuments GeneratedDocument[]

  @@index([userId, createdAt])
  @@index([userId, folderType])
  @@map("case_folders")
}

model Document {
  id               String         @id @default(cuid())
  userId           String
  folderId         String?
  originalName     String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  checksum         String
  pageCount        Int?
  documentType     String?
  status           DocumentStatus @default(UPLOADED)
  ocrTextEncrypted String?
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder       CaseFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  analyses     DocumentAnalysis[]
  calculations Calculation[]
  deadlines    Deadline[]

  @@unique([userId, checksum])
  @@index([userId, createdAt])
  @@index([folderId])
  @@index([status])
  @@map("documents")
}

model DocumentAnalysis {
  id               String   @id @default(cuid())
  documentId       String
  schemaVersion    String
  provider         String
  model            String
  promptVersion    String
  extractedData    Json
  summary          String?
  warnings         Json
  recommendedTools Json
  confidenceScore  Decimal? @db.Decimal(5, 4)
  requiresReview   Boolean  @default(false)
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUsd Decimal? @db.Decimal(12, 6)
  createdAt        DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@map("document_analyses")
}

model Calculation {
  id              String            @id @default(cuid())
  userId          String
  folderId        String?
  documentId      String?
  calculationType String
  engineVersion   String
  ruleSetVersion  String
  inputData       Json
  outputData      Json
  status          CalculationStatus @default(COMPLETED)
  createdAt       DateTime          @default(now())
  invalidatedAt   DateTime?

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder   CaseFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  document Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([folderId])
  @@index([calculationType])
  @@map("calculations")
}

model Deadline {
  id                String         @id @default(cuid())
  userId            String
  folderId          String?
  documentId        String?
  title             String
  ruleId            String
  ruleVersion       String
  startEvent        String
  startDate         DateTime
  calculatedEndDate DateTime
  adjustedEndDate   DateTime
  status            DeadlineStatus @default(ACTIVE)
  legalBasis        Json
  warnings          Json
  completedAt       DateTime?
  invalidatedAt     DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder        CaseFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  document      Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([userId, adjustedEndDate])
  @@index([status, adjustedEndDate])
  @@map("deadlines")
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  deadlineId  String?
  title       String
  body        String
  scheduledAt DateTime
  sentAt      DateTime?
  failedAt    DateTime?
  providerId  String?
  createdAt   DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deadline Deadline? @relation(fields: [deadlineId], references: [id], onDelete: Cascade)

  @@index([scheduledAt, sentAt])
  @@index([userId, scheduledAt])
  @@map("notifications")
}

model GeneratedDocument {
  id              String   @id @default(cuid())
  userId          String
  folderId        String?
  documentType    String
  templateVersion String
  inputData       Json
  storageKey      String?
  createdAt       DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder CaseFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("generated_documents")
}

model RuleSet {
  id          String    @id @default(cuid())
  module      String
  ruleKey     String
  version     String
  validFrom   DateTime
  validTo     DateTime?
  ruleData    Json
  legalBasis  Json
  sourceUrl   String?
  sourceHash  String?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  // Otonom Mevzuat Sistemi alanları — status, servis katmanınca
  // isPublished ile senkron tutulur (bkz. ReleaseDecisionService).
  status                         RuleSetStatus         @default(DRAFT)
  selectorDateType               RuleSelectorDateType?
  requiresFavorableLawComparison Boolean               @default(false)
  confidenceScore                Decimal?              @db.Decimal(5, 4)
  verifiedAt                     DateTime?

  changeId String?
  change   LegislationChange? @relation(fields: [changeId], references: [id])

  supersedesRuleSetId String?
  supersedes          RuleSet?  @relation("RuleSetSupersedes", fields: [supersedesRuleSetId], references: [id])
  supersededBy        RuleSet[] @relation("RuleSetSupersedes")

  verificationResults RuleVerificationResult[]
  goldenTestResults   GoldenTestResult[]

  @@unique([ruleKey, version])
  @@index([module, isPublished])
  @@index([validFrom, validTo])
  @@index([status])
  @@map("rule_sets")
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique
  name      String
  isHalfDay Boolean  @default(false)
  source    String?

  @@map("holidays")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// --- Otonom Mevzuat Sistemi ---
// Resmî kaynak izleme → değişiklik tespiti → etki analizi → kural
// üretimi → bağımsız doğrulama → golden test → yayın kararı →
// geriye dönük düzeltme boru hattının veri modeli. Bkz. CLAUDE.md.

model LegislationSource {
  id                  String                    @id @default(cuid())
  key                 String                    @unique
  name                String
  url                 String
  category            LegislationSourceCategory
  pollIntervalMinutes Int
  lastPolledAt        DateTime?
  createdAt           DateTime                  @default(now())

  documents LegislationDocument[]

  @@map("legislation_sources")
}

model LegislationDocument {
  id              String   @id @default(cuid())
  sourceId        String
  publicationDate DateTime
  gazetteNumber   String?
  documentType    String
  title           String
  contentHash     String
  // Tam metin (Doküman modeli gibi bir S3 storageKey'e değil, doğrudan
  // DB'ye saklanır — bunlar taranmış ikili dosyalar değil, kamuya açık
  // resmî metinlerdir; Legal Diff Agent'ın madde bazında karşılaştırma
  // yapabilmesi için gereklidir).
  rawText         String
  sourceUrl       String
  downloadedAt    DateTime @default(now())

  source  LegislationSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  changes LegislationChange[]

  @@index([sourceId, publicationDate])
  @@index([contentHash])
  @@map("legislation_documents")
}

model LegislationChange {
  id                  String                  @id @default(cuid())
  documentId          String
  affectedLegislation String
  changeType          LegislationChangeType
  affectedSections    Json
  oldTextHash         String?
  newTextHash         String
  effectiveDate       DateTime
  publicationDate     DateTime
  status              LegislationChangeStatus @default(DETECTED)
  createdAt           DateTime                @default(now())

  document         LegislationDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  impactAssessment RuleImpactAssessment?
  ruleSets         RuleSet[]

  @@index([documentId])
  @@index([status])
  @@map("legislation_changes")
}

model RuleImpactAssessment {
  id                String    @id @default(cuid())
  changeId          String    @unique
  affectedModules   Json
  affectedRuleIds   Json
  historicalImpact  Boolean
  prospectiveImpact Boolean
  requiresMigration Boolean
  riskLevel         RiskLevel
  dateSelectorNotes Json?
  createdAt         DateTime  @default(now())

  change LegislationChange @relation(fields: [changeId], references: [id], onDelete: Cascade)

  @@map("rule_impact_assessments")
}

model RuleVerificationResult {
  id        String            @id @default(cuid())
  ruleSetId String
  layer     VerificationLayer
  passed    Boolean
  details   Json
  createdAt DateTime          @default(now())

  ruleSet RuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  @@index([ruleSetId, layer])
  @@map("rule_verification_results")
}

model GoldenTestCase {
  id              String   @id @default(cuid())
  ruleKey         String
  name            String
  facts           Json
  expectedOutcome Json
  createdAt       DateTime @default(now())

  results GoldenTestResult[]

  @@index([ruleKey])
  @@map("golden_test_cases")
}

model GoldenTestResult {
  id            String   @id @default(cuid())
  testCaseId    String
  ruleSetId     String
  passed        Boolean
  actualOutcome Json
  createdAt     DateTime @default(now())

  testCase GoldenTestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  ruleSet  RuleSet        @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  @@index([ruleSetId])
  @@map("golden_test_results")
}

// supersededRuleSetId/newRuleSetId ve affectedDeadlineIds, AuditLog.entityId
// ile aynı gevşek bağlı (FK'siz) kayıt desenini izler — bu tablo yalnızca
// bir izleme/denetim kaydıdır, referans bütünlüğü RuleRemediationService
// tarafından uygulama katmanında sağlanır.
model RuleRemediation {
  id                  String            @id @default(cuid())
  supersededRuleSetId String
  newRuleSetId        String
  affectedDeadlineIds Json
  status              RemediationStatus @default(PENDING)
  createdAt           DateTime          @default(now())

  @@map("rule_remediations")
}
