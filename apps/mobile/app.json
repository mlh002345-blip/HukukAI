{
  "expo": {
    "name": "HukukAI",
    "slug": "hukukai",
    "scheme": "hukukai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "primaryColor": "#175CD3",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#175CD3"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.hukukai.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.hukukai.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Belgelerinizi taramak ve analiz için yüklemek amacıyla kameraya erişim gereklidir.",
        "NSPhotoLibraryUsageDescription": "Belgelerinizi galeriden seçip analiz için yüklemek amacıyla fotoğraf kitaplığına erişim gereklidir."
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#175CD3"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
