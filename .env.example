# =============================================================================
# HukukAI — Ortam Değişkenleri Örneği
# Bu dosyayı .env olarak kopyalayın: cp .env.example .env
# ÖNEMLİ: Gerçek .env dosyası asla commit edilmez (.gitignore içinde).
# =============================================================================

# --- apps/api ---
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://hukukai:hukukai_dev_password@localhost:5432/hukukai?schema=public
REDIS_URL=redis://localhost:6379

# openssl rand -base64 48 ile üretin
JWT_ACCESS_SECRET=change-me-in-production-min-32-characters-long
JWT_REFRESH_SECRET=change-me-in-production-min-32-characters-long-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# MinIO (yerel geliştirme) — üretimde S3 uyumlu bir sağlayıcı kullanılır
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=hukukai
S3_SECRET_KEY=hukukai_dev_password
S3_BUCKET=hukukai-documents
S3_FORCE_PATH_STYLE=true

# AI sağlayıcısı değiştirilebilir olmalıdır (Bölüm 29, madde 15)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# Ödeme sağlayıcısı değiştirilebilir olmalıdır (Faz 8 — Bölüm 23)
PAYMENT_PROVIDER=mock

# OCR metninin şifrelenmesi (Bölüm 20 — Güvenlik ve KVKK)
# openssl rand -base64 48 ile üretin
DOCUMENT_TEXT_ENCRYPTION_KEY=change-me-in-production-min-32-characters-long

CORS_ORIGINS=*
LOG_LEVEL=info

# --- apps/mobile (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# --- apps/admin (Next.js) ---
ADMIN_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
